# NEW installations only; chmod 600 .env. Do not copy these defaults over an existing site.
COMPOSE_PROJECT_NAME=pixcook-sub2api
# Obtain the exact digest from the approved release metadata; tags/latest are rejected.
PIXCOOK_IMAGE=
SERVER_PORT=8080
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Generate each independently, for example: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
TOTP_ENCRYPTION_KEY=CHANGE_ME
ADMIN_EMAIL=
ADMIN_PASSWORD=
TZ=Asia/Shanghai
