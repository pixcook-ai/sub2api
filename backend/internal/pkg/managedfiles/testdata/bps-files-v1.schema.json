{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bps-files:1",
  "title": "BPS private managed Files v1",
  "description": "Structural schema only. The strict lexical JSON profile and positional/identity/byte validation are additional mandatory checks.",
  "$ref": "#/$defs/admit_manifest",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "credential_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "backend_id",
        "subject_fingerprint",
        "credential_generation"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "part": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "part"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_ref": {
          "type": "string",
          "pattern": "^file-[A-Za-z0-9_-]+$",
          "maxLength": 256
        },
        "mode": {
          "enum": [
            "upload",
            "existing"
          ]
        },
        "part": {
          "type": "string",
          "maxLength": 64
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 209715200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "remote_id": {
          "type": "string",
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "maxLength": 256
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      },
      "required": [
        "file_ref",
        "mode",
        "filename",
        "mime",
        "bytes",
        "sha256",
        "positions"
      ],
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "upload"
            },
            "part": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "remote_id": {
              "const": ""
            },
            "operation_id": {
              "const": ""
            }
          },
          "required": [
            "part"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "existing"
            },
            "part": {
              "const": ""
            },
            "remote_id": {
              "type": "string",
              "pattern": "^file-[A-Za-z0-9_-]+$",
              "maxLength": 256
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "remote_id",
            "operation_id"
          ]
        }
      ]
    },
    "admit_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "bps-files/1"
        },
        "json_profile": {
          "const": "bps-files-json/1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected": {
          "$ref": "#/$defs/identity"
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "group_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_template": {
          "type": "object",
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "array"
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          },
          "maxItems": 128
        }
      },
      "required": [
        "contract",
        "json_profile",
        "request_id",
        "expected",
        "owner_ref",
        "group_ref",
        "request_template",
        "files"
      ]
    },
    "ensure_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "bps-files/1"
        },
        "expected": {
          "$ref": "#/$defs/identity"
        },
        "admission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "file_ref": {
          "type": "string",
          "pattern": "^file-[A-Za-z0-9_-]+$",
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "contract",
        "expected",
        "admission_id",
        "file_ref",
        "operation_id"
      ]
    },
    "admit_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "bps-files/1"
        },
        "json_profile": {
          "const": "bps-files-json/1"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "admission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ready": {
          "type": "boolean"
        },
        "wire_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file_ref": {
                "type": "string",
                "pattern": "^file-[A-Za-z0-9_-]+$",
                "maxLength": 256
              },
              "state": {
                "enum": [
                  "staged",
                  "known"
                ]
              }
            },
            "required": [
              "file_ref",
              "state"
            ]
          }
        }
      },
      "required": [
        "contract",
        "json_profile",
        "identity",
        "admission_id",
        "expires_at",
        "template_sha256",
        "ready",
        "files"
      ],
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "wire_sha256",
          "binding_sha256"
        ]
      },
      "else": {
        "properties": {
          "wire_sha256": false,
          "binding_sha256": false
        }
      }
    },
    "ensure_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "bps-files/1"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "file_ref": {
          "type": "string",
          "pattern": "^file-[A-Za-z0-9_-]+$",
          "maxLength": 256
        },
        "remote_id": {
          "type": "string",
          "pattern": "^file-[A-Za-z0-9_-]+$",
          "maxLength": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 209715200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        },
        "wire_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "contract",
        "identity",
        "operation_id",
        "file_ref",
        "remote_id",
        "bytes",
        "sha256",
        "filename",
        "mime",
        "input_tokens",
        "ready"
      ],
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "wire_sha256",
          "binding_sha256"
        ]
      },
      "else": {
        "properties": {
          "wire_sha256": false,
          "binding_sha256": false
        }
      }
    },
    "describe_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "credential_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract": {
          "const": "bps-files/1"
        },
        "json_profile": {
          "const": "bps-files-json/1"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 209715200
            },
            "message_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288000
            },
            "message_positions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "staging_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "admission_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "concurrent_admissions": {
              "type": "integer",
              "minimum": 1
            },
            "live_admissions": {
              "type": "integer",
              "minimum": 1
            },
            "admission_ttl_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "manifest_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "unique_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "free_space_reserve_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "admit_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "ensure_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "file_bytes",
            "message_bytes",
            "message_positions",
            "staging_bytes",
            "admission_bytes",
            "concurrent_admissions",
            "live_admissions",
            "admission_ttl_seconds",
            "manifest_bytes",
            "unique_files",
            "free_space_reserve_bytes",
            "admit_timeout_seconds",
            "ensure_timeout_seconds"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batch_admit": {
              "type": "boolean"
            },
            "ensure_upload": {
              "type": "boolean"
            },
            "metadata_recovery": {
              "type": "boolean"
            }
          },
          "required": [
            "batch_admit",
            "ensure_upload",
            "metadata_recovery"
          ]
        }
      },
      "required": [
        "backend_id",
        "subject_fingerprint",
        "credential_generation",
        "contract",
        "json_profile",
        "limits",
        "capabilities"
      ]
    }
  }
}
